{
  "name": "elix",
  "version": "0.1.0",
  "description": "Elix — an autonomous Minecraft Java Edition companion that plays like a friend.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "elix": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/bin.ts",
    "start": "tsx src/cli/bin.ts start",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "doctor": "tsx src/cli/bin.ts doctor",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "dotenv": "^17.0.0",
    "ffmpeg-static": "^5.3.0",
    "js-yaml": "^5.4.2",
    "minecraft-data": "file:vendor/minecraft-data",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "prismarine-chat": "^1.13.0",
    "vec3": "^0.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "tsup": "^8.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.1.0"
  }
}
