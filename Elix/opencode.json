{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "question": "deny",
    "doom_loop": "allow",
    "external_directory": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git clean*": "deny",
      "git reset --hard origin*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf ..*": "deny",
      "rd /s*": "deny",
      "del /s*": "deny",
      "Remove-Item * -Recurse*": "deny",
      "format *": "deny",
      "shutdown*": "deny"
    }
  }
}