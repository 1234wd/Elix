# Copy to .env and fill in. .env is gitignored — never commit keys.
#
# All providers are OpenAI-compatible; Elix picks the first available match
# from the config/models.yaml preference lists. Cloud AI only — no local models
# and no downloaded weights of any kind (LLM, embeddings, STT, TTS, VAD).
#
# If every provider is down or out of quota, Elix says "brb, lag" and keeps
# playing on reflex + skill code. Nothing here is required for `elix start`:
# without keys, phase 2 still connects and plays.

GROQ_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=