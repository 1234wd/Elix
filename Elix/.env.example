# Copy to .env and fill in. .env is gitignored — never commit keys.
#
# Two cloud providers. Elix picks the first available model from the
# config/models.yaml preference lists.
#   groq -> https://api.groq.com/openai/v1      (chat, planning, STT, TTS, guard)
#   hf   -> https://router.huggingface.co/v1   (chat fallback, embeddings)
#
# The `builtin` provider needs no key: it is Elix's own scripted fallback code.
#
# If every provider is down or out of quota, Elix says "brb, lag" and keeps
# playing on reflex + skill code. Nothing here is required for `elix start` —
# without keys, phase 2 still connects and plays.

GROQ_API_KEY=
HF_TOKEN=